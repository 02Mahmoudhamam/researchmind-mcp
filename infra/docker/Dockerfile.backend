FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl && rm -rf /var/lib/apt/lists/*

# Poetry installs into a virtualenv by default. In a container that is exactly
# wrong: the dependencies land in /root/.cache/pypoetry/virtualenvs/... while
# CMD below runs /usr/local/bin/python, so the image builds successfully and
# then dies at startup with `ModuleNotFoundError: No module named 'uvicorn'`.
# The container IS the isolated environment.
ENV POETRY_VIRTUALENVS_CREATE=false

# poetry.lock without a glob: the `poetry.lock*` form silently succeeded when no
# lockfile existed, resolving fresh versions at build time. A missing lockfile
# must fail the build, not produce a differently-pinned image.
COPY pyproject.toml poetry.lock ./
RUN pip install --no-cache-dir poetry && poetry install --only main --no-interaction

COPY . .

# Bake the embedding model into the image (ADR-0004 §2). Without this the first
# job to embed downloads 67 MB while a document waits, every replica downloads
# it separately, and a worker started without network access fails at its first
# document rather than at boot. EMBEDDING_CACHE_DIR is set here so the fetch
# below and the running container agree on where the weights are; compose sets
# the same value for the worker.
ENV EMBEDDING_CACHE_DIR=/app/.fastembed_cache
RUN python scripts/fetch-embedding-model.py

EXPOSE 8000

CMD ["python", "main.py"]

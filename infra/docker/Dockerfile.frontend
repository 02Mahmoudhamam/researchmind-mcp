FROM node:26-alpine AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .

# NEXT_PUBLIC_* values are inlined into the browser bundle by `next build`,
# so they must be supplied HERE, at build time. Setting them on the running
# container (docker-compose `environment:`) cannot change an already-built
# bundle. The default must be reachable from the user's BROWSER, which runs
# on the host and cannot resolve the compose-internal name `backend`.
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

RUN npm run build

FROM node:26-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
EXPOSE 3000
CMD ["node", "server.js"]

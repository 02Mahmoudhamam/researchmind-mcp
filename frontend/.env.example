# ---------------------------------------------------------------------------
# ResearchMind MCP — FRONTEND environment example
#
#   cd frontend && cp .env.example .env.local
#
# WARNING: every NEXT_PUBLIC_* variable is embedded in the browser bundle and
# is therefore PUBLIC. Never put a secret behind this prefix.
#
# These variables previously lived in the backend .env.example, where they
# caused Settings() to raise ValidationError: extra_forbidden, breaking the
# first command in the documented Quick Start.
#
# Full reference: ../docs/development/environment.md
# ---------------------------------------------------------------------------

# Base URL of the ResearchMind backend API.
# Use http://backend:8000 when running under docker compose.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Display name shown in the UI.
NEXT_PUBLIC_APP_NAME=ResearchMind

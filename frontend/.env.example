# ---------------------------------------------------------------------------
# ResearchMind MCP — FRONTEND environment example
#
#   cd frontend && cp .env.example .env.local
#
# WARNING: every NEXT_PUBLIC_* variable is embedded in the browser bundle and
# is therefore PUBLIC. Never put a secret behind this prefix.
#
# These are BUILD-TIME values. `next build` inlines them into the bundle, so
# changing them on an already-built container has no effect. Under docker
# compose they are passed as build args, not `environment:` — see
# infra/docker/Dockerfile.frontend.
#
# These variables previously lived in the backend .env.example, where they
# caused Settings() to raise ValidationError: extra_forbidden, breaking the
# first command in the documented Quick Start.
#
# Full reference: ../docs/development/environment.md
# ---------------------------------------------------------------------------

# Base URL of the ResearchMind backend API.
# This value is consumed by the BROWSER, which runs on the host — so it uses the
# published port even under docker compose. The compose-internal name
# `backend:8000` would not resolve there.
#
# Read by src/lib/api.ts, which no page imports yet, so it does not currently
# reach any bundle. That changes when the UI is wired up (M1+).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Display name shown in the UI.
# Declared for the planned UI; no source file reads it yet (verified S0.4).
NEXT_PUBLIC_APP_NAME=ResearchMind

# ---------------------------------------------------------------------------
# ResearchMind MCP — BACKEND environment example
#
#   cp .env.example .env
#
# Placeholders only. Never commit a real value — not even an expired one.
#
# Every variable below is declared by backend/config/settings.py. Settings uses
# pydantic-settings, which currently rejects unknown keys (extra="forbid"), so
# adding a variable here before the Settings field that consumes it will stop
# the application from starting. Frontend variables live in
# frontend/.env.example for exactly this reason.
#
# Full reference: docs/development/environment.md
# ---------------------------------------------------------------------------

# --- REQUIRED --------------------------------------------------------------
# No default. The application will not start without it.
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- REQUIRED IN PRODUCTION ------------------------------------------------
# Defaulted to "changeme" for local development only. From Sprint M2/S2.1 the
# application refuses to start with these values when APP_ENV != development.
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret

# --- Application -----------------------------------------------------------
APP_NAME=ResearchMind MCP
APP_ENV=development
APP_PORT=8000
# DEBUG=true also enables the /docs OpenAPI UI. Must be false in production.
DEBUG=true

# --- Claude ----------------------------------------------------------------
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- Qdrant (vector index) -------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=researchmind

# --- Redis (job queue, rate limiting) --------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL=86400

# --- Authentication --------------------------------------------------------
# The algorithm is pinned explicitly at decode and never read from the token
# header. JWT_EXPIRE_MINUTES drops to 60 at M2 (access tokens only, no refresh).
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

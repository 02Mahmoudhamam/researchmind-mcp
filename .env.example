# ---------------------------------------------------------------------------
# ResearchMind MCP — BACKEND environment example
#
#   cp .env.example .env
#
# Placeholders only. Never commit a real value — not even an expired one.
#
# Every variable below is declared by backend/config/settings.py. Unknown keys
# are ignored rather than fatal (extra="ignore", set in Sprint M0/S0.1), but a
# variable listed here that the backend does not read is still misleading, so
# add one only alongside the Settings field that consumes it. Frontend
# variables live in frontend/.env.example.
#
# Full reference: docs/development/environment.md
# ---------------------------------------------------------------------------

# --- REQUIRED --------------------------------------------------------------
# No default. The application will not start without it.
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- REQUIRED IN PRODUCTION ------------------------------------------------
# Defaulted to "changeme" for local development only. **Since Sprint M2/S2.1 the
# application refuses to start** with a placeholder, empty, or under-32-character
# value whenever APP_ENV is anything other than "development" — staging and CI
# included. The error names the setting, never the value.
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret

# --- Application -----------------------------------------------------------
APP_NAME=ResearchMind MCP
APP_ENV=development
APP_PORT=8000
# DEBUG=true also enables the /docs OpenAPI UI. Must be false in production.
DEBUG=true

# --- Claude ----------------------------------------------------------------
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- PostgreSQL (system of record) -----------------------------------------
# Must use the asyncpg driver. `postgresql://` is rejected at startup by a
# validator in Settings: the application drives an async engine (ADR-0003) and
# a synchronous DSN cannot back it.
#
# BUILD/RUNTIME NOTE: this value is read at runtime, so it can be changed
# without rebuilding. Under `docker compose` the backend service overrides it
# with host `postgres`; the value below is for running the API on the host
# against the compose-published port. The credentials are the development ones
# declared in docker-compose.yml — they are not secrets.
DATABASE_URL=postgresql+asyncpg://researchmind:researchmind@localhost:5432/researchmind

# Connection pool. The ceiling on concurrent database sessions is
# DB_POOL_SIZE + DB_MAX_OVERFLOW.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
# Echoes every SQL statement, values included. Never enable outside local
# debugging.
DB_ECHO=false

# --- Qdrant (vector index) -------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=researchmind

# --- Redis (job queue, rate limiting) --------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL=86400

# --- Authentication --------------------------------------------------------
# The algorithm is pinned explicitly at decode and never read from the token
# header, and is constrained to HS256/HS384/HS512 — a value outside that list
# (notably "none") is refused at startup rather than silently disabling
# signature verification.
#
# 60 minutes, and access tokens only: there is no refresh token and no
# server-side revocation in the MVP, so a stolen token is valid until it
# expires. That is the whole reason the TTL is short.
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- CORS ------------------------------------------------------------------
# Comma-separated. Replaces the wildcard that used to be hard-coded: once
# Authorization means something, "*" lets any page a user visits drive this API
# with their token.
#
# Credentials are deliberately NOT enabled — the frontend sends a bearer header
# rather than a cookie, so it does not need them.
CORS_ORIGINS=http://localhost:3000

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
